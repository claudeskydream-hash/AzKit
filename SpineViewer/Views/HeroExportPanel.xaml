<UserControl x:Class="SpineViewer.Views.HeroExportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpineViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HeroExportViewModel}"
             mc:Ignorable="d"
             IsVisibleChanged="HeroExportPanel_IsVisibleChanged">
    <!-- [AzureSail 新增] 左侧栏「母骨骼导出」页：一个英雄 = 美术/角色/子骨骼 下的一个英雄文件夹（图在 images/阶段/ 下）；
         右键条目导出，调用工程里的 tools/SpineHeroExport/export_hero.py。操作说明见工程 ReadMarkDown/英雄Spine导出操作手册.md -->
    <DockPanel Margin="4">
        <!-- 母骨骼与英雄目录（存在 heroes.json，换了点「全部导出」生效） -->
        <Grid DockPanel.Dock="Top" Margin="0 0 0 4" IsEnabled="{Binding IsIdle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Text="母骨骼" VerticalAlignment="Center" Margin="0 0 6 0"/>
            <TextBox Grid.Column="1" Text="{Binding MasterPath, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"
                     ToolTip="{Binding MasterPath}"/>
            <Button Grid.Column="2" Content="更换..." Command="{Binding Cmd_ChangeMaster}" Margin="4 2 0 2"
                    ToolTip="换成另一个母骨骼 .spine；换完点「全部导出」"/>
            <TextBlock Grid.Row="1" Text="英雄目录" VerticalAlignment="Center" Margin="0 0 6 0"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding HeroRoot, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"
                     ToolTip="{Binding HeroRoot}"/>
            <Button Grid.Row="1" Grid.Column="2" Content="更换..." Command="{Binding Cmd_ChangeHeroRoot}" Margin="4 2 0 2"
                    ToolTip="选「子骨骼」这一层（不是某个英雄的文件夹）：里面每个子文件夹是一个英雄"/>
        </Grid>

        <!-- 底部：全部导出；单个英雄的操作在右键菜单里 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0 4 0 0">
            <Button DockPanel.Dock="Right" Content="全部导出" Command="{Binding Cmd_ExportAll}" IsEnabled="{Binding IsIdle}"
                    ToolTip="母骨骼改了骨骼或动画之后用：所有英雄重新导出，并把母骨骼同步进各英雄的 .spine（原文件带时间戳备份进 _backup）"/>
            <TextBlock Text="右键英雄条目：导出 / 导出到表格 / 在 Spine 中打开" Foreground="Gray"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="1.2*"/>
            </Grid.RowDefinitions>

            <DataGrid ItemsSource="{Binding Heroes}" SelectedItem="{Binding SelectedHero}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" IsEnabled="{Binding IsIdle}">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="导出看效果" Command="{Binding Cmd_Export}"
                                  ToolTip="导出到 res/spine/Hero/英雄号/ 并加载到画面，不碰英雄表；同时把母工程的骨骼、动画同步进英雄 .spine（有变化才写，先备份进 _backup）；第一次导出会在英雄文件夹里生成同名 .spine"/>
                        <MenuItem Header="同步到子工程 spine" Command="{Binding Cmd_SyncOnly}"
                                  ToolTip="只把母工程的骨骼、动画同步进英雄 .spine，不导出游戏文件（有变化才写，先备份进 _backup）"/>
                        <MenuItem Header="导出到表格" Command="{Binding Cmd_ExportToTable}"
                                  ToolTip="导出 + 英雄表里有这个英雄的行就覆盖（只改 Spine 路径、名字）、没有就新建 + 资源声明 + 导表并编译两端，做完就能进游戏。按「表 id」认行，改英雄号也不会重复加"/>
                        <Separator/>
                        <MenuItem Header="在 Spine 中打开" Command="{Binding Cmd_OpenSpine}"
                                  ToolTip="打开英雄文件夹里的 .spine：加图、改网格都在这里改，下次导出就用它"/>
                        <MenuItem Header="描绘网格（写进 .spine）" Command="{Binding Cmd_Trace}"
                                  ToolTip="换过图的部件按新图重新描绘成贴合轮廓的网格（母骨骼里是网格的才描），权重和形变动画从母网格换算；写回前带时间戳备份进 _backup"/>
                        <MenuItem Header="打开图片文件夹" Command="{Binding Cmd_OpenFolder}"/>
                        <Separator/>
                        <MenuItem Header="新增英雄..." Command="{Binding Cmd_AddHero}"
                                  ToolTip="一般不用：放进 美术/角色/子骨骼 的英雄文件夹会自动出现在列表里"/>
                        <MenuItem Header="从列表删除" Command="{Binding Cmd_RemoveHero}"
                                  ToolTip="只从列表删，不删文件、不改英雄表；extras / adjust / hide 配置会一起删掉"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="英雄号" Width="Auto" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}"/>
                    <DataGridTextColumn Header="名字" Width="Auto" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="表 id" Width="Auto" Binding="{Binding TableId, Mode=OneWay}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="状态" Width="Auto" Binding="{Binding Status, Mode=OneWay}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="英雄文件夹" Width="*" Binding="{Binding Source}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <TextBox Grid.Row="2" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True"
                     VerticalContentAlignment="Top" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Microsoft YaHei UI"
                     TextChanged="LogTextBox_TextChanged"/>
        </Grid>
    </DockPanel>
</UserControl>
