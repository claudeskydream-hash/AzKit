<UserControl x:Class="SpineViewer.Views.NotepadEditorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">

    <!-- [AzureSail 新增] 右侧「笔记」页签：编辑左侧栏记事本树里点中的文件。DataContext = NotepadViewModel -->
    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding Cmd_Save}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding Cmd_NewNote}"/>
    </UserControl.InputBindings>

    <DockPanel>
        <!-- 标题条：当前文件名（改过带 *）+ 完整路径 -->
        <DockPanel DockPanel.Dock="Top" Margin="8 4">
            <TextBlock DockPanel.Dock="Right" Foreground="Gray" VerticalAlignment="Center"
                       Text="Ctrl+S 保存 · Ctrl+Z 撤销 · Ctrl+Y 重做"/>
            <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedDocument.Header}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding SelectedDocument.FilePath}" Foreground="Gray" Margin="10 0" VerticalAlignment="Center"
                       ToolTip="{Binding SelectedDocument.FilePath}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid>
            <!-- 只有一个编辑器，切文件时换 Document 与高亮（md / json 各有高亮，txt 纯文本）；撤销记录跟着 Document 走，各文件互不影响 -->
            <avalonEdit:TextEditor x:Name="_editor"
                                   Document="{Binding SelectedDocument.Document}"
                                   SyntaxHighlighting="{Binding SelectedDocument.Highlighting}"
                                   ShowLineNumbers="True"
                                   WordWrap="True"
                                   FontFamily="Consolas, Microsoft YaHei UI"
                                   FontSize="15"
                                   Padding="6"
                                   Background="White"
                                   HorizontalScrollBarVisibility="Disabled"
                                   VerticalScrollBarVisibility="Auto">
                <avalonEdit:TextEditor.Style>
                    <Style TargetType="avalonEdit:TextEditor">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                <Setter Property="Visibility" Value="Hidden"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </avalonEdit:TextEditor.Style>
                <avalonEdit:TextEditor.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="撤销" InputGestureText="Ctrl+Z" Command="Undo"/>
                        <MenuItem Header="重做" InputGestureText="Ctrl+Y" Command="Redo"/>
                        <Separator/>
                        <MenuItem Header="剪切" InputGestureText="Ctrl+X" Command="Cut"/>
                        <MenuItem Header="复制" InputGestureText="Ctrl+C" Command="Copy"/>
                        <MenuItem Header="粘贴" InputGestureText="Ctrl+V" Command="Paste"/>
                        <Separator/>
                        <MenuItem Header="全选" InputGestureText="Ctrl+A" Command="SelectAll"/>
                    </ContextMenu>
                </avalonEdit:TextEditor.ContextMenu>
            </avalonEdit:TextEditor>

            <TextBlock Text="在左侧记事本里点一个文件，或新建笔记"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDocument}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
