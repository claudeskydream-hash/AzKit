<UserControl x:Class="SpineViewer.Views.CloudSaveDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SpineViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:CloudSaveViewModel}"
             mc:Ignorable="d">
    <!-- [AzureSail 新增] 右侧「存档」页：状态、结果与选中区的各段存档（操作在左侧栏「云存档」页）。
         每次请求的记录点「历史记录」弹窗看（CloudCallHistoryDialog） -->
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="1.2*"/>
        </Grid.RowDefinitions>

        <!-- 状态：当前在做什么；每次请求的返回在「历史记录」弹窗里 -->
        <DockPanel Grid.Row="0" Margin="0 0 0 6">
            <Button DockPanel.Dock="Right" Command="{Binding Cmd_ShowCalls}" Margin="6 0 0 0"
                    Content="{Binding Calls.Count}" ContentStringFormat="历史记录（{0}）"
                    ToolTip="弹窗查看每次请求的时间、接口、HTTP 状态、耗时与返回（失败的标红）"/>
            <TextBlock Text="状态" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 8 0"/>
            <Border CornerRadius="3" Padding="6 2" VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#22808080"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="busy">
                                <Setter Property="Background" Value="#33FF9800"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                <Setter Property="Background" Value="#334CAF50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusKind}" Value="error">
                                <Setter Property="Background" Value="#33F44336"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}"/>
            </Border>
        </DockPanel>

        <!-- 结果 -->
        <DockPanel Grid.Row="1" Margin="0 2 0 2">
            <Button DockPanel.Dock="Right" Content="打开备份目录" Command="{Binding Cmd_OpenBackupFolder}"
                    ToolTip="删除前的备份（data\cloudbackup），格式同 EditCloudStore 快照，可用它的 update --file 恢复"/>
            <TextBlock Text="结果" FontWeight="Bold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox Grid.Row="2" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>

        <GridSplitter Grid.Row="3" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

        <!-- 选中区的存档段 -->
        <TextBlock Grid.Row="4" FontWeight="Bold" Margin="0 2 0 2"
                   Text="{Binding SelectedServer.Title, StringFormat='选中区的存档段：{0}', FallbackValue='选中区的存档段（在左侧区服列表里点一个区）'}"/>
        <DataGrid Grid.Row="5" ItemsSource="{Binding SelectedKeys}" SelectedItem="{Binding SelectedKey}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="key" Width="Auto" Binding="{Binding Key}"/>
                <DataGridTextColumn Header="大小" Width="Auto" Binding="{Binding Size}"/>
                <DataGridTextColumn Header="值预览" Width="*" Binding="{Binding Preview}"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="6" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

        <!-- 选中那段的完整内容 -->
        <TextBox Grid.Row="7" Text="{Binding SelectedKeyValue, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"/>
    </Grid>
</UserControl>
