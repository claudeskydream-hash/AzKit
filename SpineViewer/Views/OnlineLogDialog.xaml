<Window x:Class="SpineViewer.Views.OnlineLogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SpineViewer.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:OnlineLogViewModel}"
        mc:Ignorable="d"
        Title="线上日志（星火后台 · 开发者工具）"
        Background="{DynamicResource RegionBrush}"
        Width="1200"
        Height="800"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!-- [AzureSail 新增] 线上日志：开局记录 + 整局服务端日志 / 报错统计 / 自定义统计（逻辑见 OnlineLogViewModel）。
         非模态，凭证用云存档页 ① 的；编辑器调试（debug）开的局不进后台，只有 test / formal 有 -->
    <DockPanel Margin="8">
        <!-- 底部：时间段（三页共用）+ 状态 -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0 6 0 0">
            <TextBlock Text="时间段：最近" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding DayOptions}" SelectedItem="{Binding Days}" Width="60" Margin="4 0"/>
            <TextBlock Text="天（三页共用）" VerticalAlignment="Center" Margin="0 0 16 0"/>
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding StatusText}" FontWeight="Bold"/>
        </DockPanel>

        <TabControl IsEnabled="{Binding IsIdle}">
            <!-- ① 开局记录 + 整局服务端日志 -->
            <TabItem Header="开局记录 / 服务端日志">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0 0 0 4">
                        <TextBlock Text="userId" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding SessionUserId, UpdateSourceTrigger=PropertyChanged}" Width="140"
                                 ToolTip="留空 = 这段时间所有玩家开的局"/>
                        <CheckBox Content="只看异常局" IsChecked="{Binding OnlyAbnormal}" Margin="12 0" VerticalAlignment="Center"/>
                        <Button Content="查询" Width="80" Command="{Binding Cmd_QuerySessions}"/>
                        <Button Content="本地缓存" Width="80" Command="{Binding Cmd_ShowCached}" Margin="12 0 0 0"
                                ToolTip="不联网，列出拉过日志的局（data\onlinelogs），token 过期也能看"/>
                        <Button Content="打开缓存目录" Command="{Binding Cmd_OpenCacheFolder}" Margin="4 0 0 0"/>
                        <Button Content="清空本地缓存" Command="{Binding Cmd_ClearCache}" Margin="4 0 0 0" Foreground="Firebrick"
                                ToolTip="删除 data\onlinelogs 下全部缓存的日志，之后再点哪一局都重新从后台拉"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="本地" Width="Auto" Binding="{Binding CachedMark}"/>
                            <DataGridTextColumn Header="服务端时间" Width="Auto" Binding="{Binding Time}"/>
                            <DataGridTextColumn Header="昵称" Width="Auto" Binding="{Binding Nickname}"/>
                            <DataGridTextColumn Header="userId" Width="Auto" Binding="{Binding UserId}"/>
                            <DataGridTextColumn Header="环境" Width="Auto" Binding="{Binding Env}"/>
                            <DataGridTextColumn Header="人数" Width="Auto" Binding="{Binding UserCount}"/>
                            <DataGridTextColumn Header="session_id" Width="Auto" Binding="{Binding SessionId}"/>
                            <DataGridTextColumn Header="异常情况" Width="*" Binding="{Binding Reason}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0 4 0 0">
                        <Button DockPanel.Dock="Right" Content="下一页" Command="{Binding Cmd_SessionNext}" Margin="4 0 0 0"/>
                        <Button DockPanel.Dock="Right" Content="上一页" Command="{Binding Cmd_SessionPrev}"/>
                        <TextBlock Text="{Binding SessionPage.Text}" Foreground="Gray" VerticalAlignment="Center"/>
                    </DockPanel>

                    <GridSplitter Grid.Row="3" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

                    <DockPanel Grid.Row="4" Margin="0 4 0 4">
                        <Button DockPanel.Dock="Right" Content="另存为…" Command="{Binding Cmd_SaveLog}" Margin="4 0 0 0"
                                ToolTip="保存整局完整日志（不受过滤影响）"/>
                        <Button DockPanel.Dock="Right" Content="重新拉取" Command="{Binding Cmd_RefetchLog}" Margin="4 0 0 0"
                                ToolTip="从后台重拉这一局并覆盖本地缓存（拉的时候那局还没结束、日志不全时用）"/>
                        <Button DockPanel.Dock="Right" Content="复制" Command="{Binding Cmd_CopyLog}" Margin="4 0 0 0"
                                ToolTip="复制当前显示的内容（过滤后的）"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LogInfo}" Foreground="Gray" VerticalAlignment="Center" Margin="8 0"/>
                        <CheckBox DockPanel.Dock="Right" Content="只看 warn / error" IsChecked="{Binding LogOnlyProblems}"
                                  VerticalAlignment="Center" Margin="8 0 0 0"/>
                        <TextBox DockPanel.Dock="Right" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="200"
                                 ToolTip="只显示含这个词的条目（不分大小写），如 userId、[CloudDB]、Exception"/>
                        <TextBlock DockPanel.Dock="Right" Text="过滤" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBlock Text="{Binding LogTitle}" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding LogTitle}"/>
                    </DockPanel>
                    <TextBox Grid.Row="5" Text="{Binding LogView, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </TabItem>

            <!-- ② 报错统计 -->
            <TabItem Header="报错统计">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0 0 0 4">
                        <RadioButton Content="服务端报错" GroupName="ErrSide" IsChecked="{Binding ErrorServerSide}" Margin="0 0 10 0" VerticalAlignment="Center"/>
                        <RadioButton Content="客户端报错" GroupName="ErrSide" Margin="0 0 16 0" VerticalAlignment="Center"/>
                        <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding ErrorKeyword, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0 0 8 0"/>
                        <Button Content="查询" Width="80" Command="{Binding Cmd_QueryErrors}"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Errors}" SelectedItem="{Binding SelectedError}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="次数" Width="Auto" Binding="{Binding Count}"/>
                            <DataGridTextColumn Header="报错（首行）" Width="*" Binding="{Binding FirstLine}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0 4 0 0">
                        <Button DockPanel.Dock="Right" Content="下一页" Command="{Binding Cmd_ErrorNext}" Margin="4 0 0 0"/>
                        <Button DockPanel.Dock="Right" Content="上一页" Command="{Binding Cmd_ErrorPrev}"/>
                        <TextBlock Text="{Binding ErrorPage.Text}" Foreground="Gray" VerticalAlignment="Center"/>
                    </DockPanel>

                    <GridSplitter Grid.Row="3" ResizeDirection="Rows" HorizontalAlignment="Stretch"/>

                    <TextBox Grid.Row="4" Text="{Binding ErrorDetail, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </TabItem>

            <!-- ③ 自定义统计 -->
            <TabItem Header="自定义统计">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0 0 0 4">
                        <TextBlock Text="环境" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <ComboBox ItemsSource="{Binding EnvOptions}" SelectedItem="{Binding EventEnv}" Width="90" Margin="0 0 12 0"/>
                        <TextBlock Text="事件名" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}" Width="160" Margin="0 0 12 0"
                                 ToolTip="留空 = 全部事件"/>
                        <TextBlock Text="userId" VerticalAlignment="Center" Margin="0 0 6 0"/>
                        <TextBox Text="{Binding EventUserId, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0 0 8 0"
                                 ToolTip="留空 = 全部玩家"/>
                        <Button Content="查询" Width="80" Command="{Binding Cmd_QueryEvents}"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Events}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Width="Auto" Binding="{Binding Time}"/>
                            <DataGridTextColumn Header="环境" Width="Auto" Binding="{Binding Env}"/>
                            <DataGridTextColumn Header="事件名" Width="Auto" Binding="{Binding EventName}"/>
                            <DataGridTextColumn Header="userId" Width="Auto" Binding="{Binding UserId}"/>
                            <DataGridTextColumn Header="属性" Width="*" Binding="{Binding Attrs}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0 4 0 0">
                        <Button DockPanel.Dock="Right" Content="下一页" Command="{Binding Cmd_EventNext}" Margin="4 0 0 0"/>
                        <Button DockPanel.Dock="Right" Content="上一页" Command="{Binding Cmd_EventPrev}"/>
                        <TextBlock Text="{Binding EventPage.Text}" Foreground="Gray" VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
